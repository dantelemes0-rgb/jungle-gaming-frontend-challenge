{
  "name": "jungle-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GreenMint — NFT Marketplace (Jungle Gaming frontend challenge)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src e2e scripts",
    "msw:init": "msw init public --save",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "preview:headers": "node scripts/preview-headers.mjs",
    "test:e2e:headed": "playwright test --headed",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.63.0",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.105.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "lighthouse": "13.6.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "^4.155.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
